{
  "name": "@ettrloz/typescript-standard",
  "version": "1.0.5",
  "description": "JavaScript and TypeScript standard project configurations",
  "license": "MIT",
  "author": "Ettrloz",
  "files": [
    "dist",
    "tsconfig",
    "types"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "types": "./types/index.d.ts"
    },
    "./*": {
      "import": "./dist/esm/*/index.mjs",
      "require": "./dist/cjs/*/index.cjs",
      "types": "./types/*/index.d.ts"
    },
    "./package.json": "./package.json",
    "./tsconfig/base": "./tsconfig/tsconfig.base.json",
    "./tsconfig/build": "./tsconfig/tsconfig.build.json"
  },
  "scripts": {
    "build": "npm-run-all build:js types",
    "build:js": "rolldown -c rolldown.config.mts",
    "prepare": "husky",
    "types": "tsc"
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rolldown": "^1.2.4",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@types/node": "^26.2.0"
  }
}
